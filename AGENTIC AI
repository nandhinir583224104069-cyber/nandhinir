class MasterAgent:
    def __init__(self, api_key: str = GEMINI_API_KEY):
        self.client = genai.Client(api_key=api_key)
        self.tools = [
            get_current_datetime,
            calculate_date_offset,
            web_search,
            query_student_records,
            get_today_weather
        ]
        self.system_instruction = (
            "You are a versatile, zero-hallucination Master AI Agent equipped with specialized tools:\n"
            "1. `get_current_datetime`: Call for current date, time, or day of the week.\n"
            "2. `calculate_date_offset`: Call for past/future date math.\n"
            "3. `web_search`: Call for breaking news, current events, and live web research.\n"
            "4. `query_student_records`: Call for ANY student database query (marks, attendance, departments, rank, phone, placement).\n"
            "5. `get_today_weather`: Call for weather in any city.\n"
            "Always call the appropriate tool(s) to fetch ground-truth data before answering."
        )
        self.current_model = PRIMARY_MODEL
        self._init_chat(self.current_model)

    def _init_chat(self, model_name: str):
        self.chat = self.client.chats.create(
            model=model_name,
            config=types.GenerateContentConfig(
                system_instruction=self.system_instruction,
                tools=self.tools,
                temperature=0.1,
            )
        )
        print(f"[*] Agent connected with model: {model_name}")

    def query(self, prompt: str) -> str:
        """Sends query with automatic retry & model fallback if 503/429 occurs."""
        for _ in range(2):
            try:
                response = self.chat.send_message(prompt)
                return response.text
            except Exception as err:
                err_str = str(err)
                if "503" in err_str or "429" in err_str or "UNAVAILABLE" in err_str:
                    print(f"\n[Notice] Model {self.current_model} busy. Switching to {FALLBACK_MODEL}...")
                    self.current_model = FALLBACK_MODEL
                    self._init_chat(self.current_model)
                    time.sleep(1)
                    continue
                return f"Error: {err_str}"
        return "Service temporarily busy. Please retry in a moment."


