# TOOL 1: DATE & TIME GROUNDING
# ==============================================================================

def get_current_datetime(timezone_name: str = "local") -> dict:
    """Returns current real-time date, time, weekday, and timezone.

    Args:
        timezone_name: Desired timezone ('local', 'UTC', 'Asia/Kolkata').
    """
    print(f"\n[Tool Execution: Date/Time] -> get_current_datetime(timezone_name='{timezone_name}')")
    try:
        if timezone_name.lower() in ("local", "system", ""):
            now = datetime.now().astimezone()
            tz_str = str(now.tzinfo)
        elif timezone_name.upper() == "UTC":
            now = datetime.now(timezone.utc)
            tz_str = "UTC"
        else:
            tz = zoneinfo.ZoneInfo(timezone_name)
            now = datetime.now(tz)
            tz_str = timezone_name
    except Exception:
        now = datetime.now().astimezone()
        tz_str = "local"

    result = {
        "iso_timestamp": now.isoformat(),
        "date": now.strftime("%Y-%m-%d"),
        "time": now.strftime("%H:%M:%S"),
        "day_of_week": now.strftime("%A"),
        "timezone": tz_str,
        "human_readable": now.strftime("%A, %B %d, %Y %I:%M:%S %p %Z")
    }
    print(f"[Tool Result]    <- {result['human_readable']}")
    return result


# ==============================================================================
# TOOL 2: DATE OFFSET CALCULATOR
# ==============================================================================

def calculate_date_offset(days_offset: int = 0, hours_offset: int = 0, reference_iso_date: str = "") -> dict:
    """Calculates future or past dates (e.g., 45 days ago, in 2 weeks).

    Args:
        days_offset: Days to add or subtract.
        hours_offset: Hours to add or subtract.
        reference_iso_date: Optional base date in YYYY-MM-DD.
    """
    print(f"\n[Tool Execution: Date Math] -> calculate_date_offset(days={days_offset}, hours={hours_offset})")
    try:
        base_date = datetime.fromisoformat(reference_iso_date) if reference_iso_date else datetime.now().astimezone()
        target_date = base_date + timedelta(days=days_offset, hours=hours_offset)
        result = {
            "base_date": base_date.strftime("%Y-%m-%d %H:%M:%S"),
            "target_date": target_date.strftime("%Y-%m-%d"),
            "target_day_of_week": target_date.strftime("%A"),
            "human_readable": target_date.strftime("%A, %B %d, %Y %I:%M:%S %p")
        }
        print(f"[Tool Result]    <- {result['human_readable']}")
        return result
    except Exception as err:
        return {"error": str(err)}


# ==============================================================================
# TOOL 3: LIVE WEB SEARCH (Clean JSON APIs - Zero Complex Regex)
# ==============================================================================

def web_search(query: str, max_results: int = 5) -> list:
    """Searches live web sources for news, events, and factual research.

    Args:
        query: Search keywords or query phrase.
        max_results: Max results to return (default 5).
    """
    print(f"\n[Tool Execution: Web Search] -> web_search(query='{query}')")
    results = []

    # 1. Wikipedia Search API (Fast, structured JSON)
    try:
        wiki_url = f"https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch={urllib.parse.quote(query)}&format=json"
        req = urllib.request.Request(wiki_url, headers=USER_AGENT_HEADER)
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for item in data.get("query", {}).get("search", [])[:max_results]:
                # Clean HTML tags using basic replace
                snippet = item.get("snippet", "").replace('<span class="searchmatch">', "").replace('</span>', "")
                results.append({
                    "title": item.get("title", ""),
                    "snippet": snippet,
                    "url": f"https://en.wikipedia.org/wiki/{urllib.parse.quote(item.get('title', ''))}"
                })
    except Exception:
        pass

    # 2. DuckDuckGo Instant Answer API (JSON fallback)
    if not results:
        try:
            ddg_url = f"https://api.duckduckgo.com/?q={urllib.parse.quote(query)}&format=json&no_html=1"
            req = urllib.request.Request(ddg_url, headers=USER_AGENT_HEADER)
            with urllib.request.urlopen(req, timeout=6) as resp:
                ddg_data = json.loads(resp.read().decode("utf-8"))
                abstract = ddg_data.get("AbstractText", "")
                if abstract:
                    results.append({
                        "title": ddg_data.get("Heading", "Summary"),
                        "snippet": abstract,
                        "url": ddg_data.get("AbstractURL", "")
                    })
        except Exception:
            pass

    print(f"[Tool Result]    <- Found {len(results)} web results")
    return results


