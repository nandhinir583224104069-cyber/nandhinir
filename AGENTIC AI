# TOOL 4: STUDENT DATABASE SEARCH (Low Cognitive Complexity Helper)
# ==============================================================================

def _matches_filters(student: dict, name: str, dept: str, status: str) -> bool:
    """Helper function to keep cognitive complexity low (SonarQube S3776)."""
    if name and name.lower() not in student["name"].lower():
        return False
    if dept and student["dept"].lower() != dept.lower():
        return False
    if status and student["placement"].lower() != status.lower():
        return False
    return True

def _matches_numeric_ranges(student: dict, min_att: int, max_att: int, min_ovr: int, min_ai: int) -> bool:
    """Helper function for attendance and score range checks."""
    if student["attendance"] < min_att or student["attendance"] > max_att:
        return False
    if student["overall"] < min_ovr or student["ai"] < min_ai:
        return False
    return True

def query_student_records(
    student_name: str = "",
    student_id: str = "",
    department: str = "",
    min_attendance: int = 0,
    max_attendance: int = 100,
    min_overall_mark: int = 0,
    min_ai_mark: int = 0,
    placement_status: str = "",
    list_all: bool = False
) -> list:
    """Queries student academic database for marks, attendance, rank, contact info, and placement.

    Args:
        student_name: Full or partial student name.
        student_id: Student ID (e.g., 'STU012').
        department: Department ('CSE', 'IT', 'AIDS', 'ECE', 'EEE').
        min_attendance: Minimum attendance percentage.
        max_attendance: Maximum attendance percentage.
        min_overall_mark: Minimum overall mark.
        min_ai_mark: Minimum AI score.
        placement_status: 'Eligible' or 'Not Eligible'.
        list_all: Retrieve all records.
    """
    print(f"\n[Tool Execution: Student Database] -> query_student_records(name='{student_name}', dept='{department}')")
    matches = []

    for s in STUDENTS_DB:
        if list_all:
            matches.append(s)
            continue
        if student_id and s["id"].lower() != student_id.lower():
            continue
        if not _matches_filters(s, student_name, department, placement_status):
            continue
        if not _matches_numeric_ranges(s, min_attendance, max_attendance, min_overall_mark, min_ai_mark):
            continue
        matches.append(s)

    if not matches and not student_name and not student_id:
        matches = STUDENTS_DB

    print(f"[Tool Result]    <- Found {len(matches)} matching records")
    return matches


