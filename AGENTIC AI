def get_today_weather(city_name: str) -> dict:
    """Fetches real-time live weather information for any given city worldwide.

    Args:
        city_name: City name, e.g. 'Chennai', 'London', 'Tokyo'.
    """
    print(f"\n[Tool Execution: Weather] -> get_today_weather(city='{city_name}')")
    try:
        geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={urllib.parse.quote(city_name)}&count=1&language=en&format=json"
        with urllib.request.urlopen(geo_url, timeout=6) as resp:
            geo_data = json.loads(resp.read().decode())

        if not geo_data.get("results"):
            return {"status": "error", "message": f"City '{city_name}' not found"}

        loc = geo_data["results"][0]
        weather_url = f"https://api.open-meteo.com/v1/forecast?latitude={loc['latitude']}&longitude={loc['longitude']}&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m&timezone=auto"
        with urllib.request.urlopen(weather_url, timeout=6) as resp:
            w_data = json.loads(resp.read().decode())

        current = w_data["current"]
        result = {
            "city": loc["name"],
            "country": loc.get("country", ""),
            "temperature_celsius": current["temperature_2m"],
            "humidity_percent": current["relative_humidity_2m"],
            "feels_like": current["apparent_temperature"],
            "wind_speed_kmh": current["wind_speed_10m"]
        }
        print(f"[Tool Result]    <- Weather in {loc['name']}: {current['temperature_2m']}°C")
        return result
    except Exception as err:
        return {"error": str(err)}


