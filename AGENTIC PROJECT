                    <span>☁️ Comfort Score</span>
                  </span>
                  <span class="font-extrabold text-white">${p.comfort_rating} / 10</span>
                </div>
                <div class="w-full bg-slate-700 h-1.5 rounded-full overflow-hidden">
                  <div class="bg-gradient-to-r from-blue-500 to-indigo-400 h-full rounded-full" style="width: ${comfortPercentage}%"></div>
                </div>
                <p class="text-[11px] text-slate-300 mt-2 line-clamp-2">
                  <strong class="text-slate-200">Ergonomics:</strong> ${p.comfort_highlights}
                </p>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between">
              <div class="text-xs text-amber-400 flex items-center space-x-1">
                <span>⭐</span>
                <span class="font-bold text-white">${p.rating}</span>
