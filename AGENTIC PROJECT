              <button onclick="openModal('${p.id}')" class="text-xs font-semibold px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition shadow-sm">
                View & Compare
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function handleSearch() {
      searchQuery = document.getElementById("searchInput").value;
      const clearBtn = document.getElementById("clearBtn");
      if (searchQuery.trim().length > 0) {
        clearBtn.classList.remove("hidden");
      } else {
        clearBtn.classList.add("hidden");
      }
      renderProducts();
    }

    function clearSearch() {
      document.getElementById("searchInput").value = "";
      searchQuery = "";
      document.getElementById("clearBtn").classList.add("hidden");
      renderProducts();
    }

    function filterCategory(cat) {
      activeCategory = cat;
      document.getElementById("activeFilterBadge").innerText = `Category: ${cat}`;
      document.querySelectorAll(".cat-pill").forEach(el => {
        if (el.innerText.includes(cat) || (cat === "All" && el.innerText.includes("All"))) {
          el.className = "cat-pill px-3 py-1 text-xs font-semibold rounded-lg bg-blue-600 text-white transition";
        } else {
          el.className = "cat-pill px-3 py-1 text-xs font-medium rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 transition";
        }
      });
      renderProducts();
    }

    function handleFilterChange() {
      minComfort = parseFloat(document.getElementById("comfortRange").value);
      maxBudget = parseInt(document.getElementById("budgetRange").value);
      sortMode = document.getElementById("sortBy").value;

      document.getElementById("comfortLabel").innerText = minComfort.toFixed(1) + " / 10";
      document.getElementById("budgetLabel").innerText = "₹" + maxBudget.toLocaleString("en-IN");
      renderProducts();
    }

    function quickTag(tag) {
      document.getElementById("searchInput").value = tag;
      handleSearch();
    }

    function resetFilters() {
      activeCategory = "All";
      searchQuery = "";
      minComfort = 5.0;
      maxBudget = 100000;
      sortMode = "comfort_desc";

      document.getElementById("searchInput").value = "";
      document.getElementById("comfortRange").value = 5.0;
      document.getElementById("budgetRange").value = 100000;
      document.getElementById("sortBy").value = "comfort_desc";
      document.getElementById("comfortLabel").innerText = "5.0 / 10";
      document.getElementById("budgetLabel").innerText = "₹1,00,000";

      filterCategory("All");
      renderProducts();
    }

    function openModal(id) {
      const p = CATALOG.find(item => item.id === id);
      if (!p) return;
      const modal = document.getElementById("productModal");
      const content = document.getElementById("modalContent");
      content.innerHTML = `
        <div class="flex items-start gap-4">
          <span class="text-4xl p-3 bg-slate-800 rounded-2xl">${p.image_icon}</span>
          <div>
            <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">${p.category}</span>
            <h3 class="text-base font-extrabold text-white">${p.name}</h3>
            <div class="text-lg font-black text-emerald-400 mt-1">₹${p.price.toLocaleString('en-IN')}</div>
          </div>
        </div>

        <div class="p-3 bg-slate-800/80 rounded-xl space-y-2 text-xs">
          <div><strong class="text-slate-300">Technical Specs:</strong> <span class="text-slate-200">${p.specs}</span></div>
          <div><strong class="text-blue-400">Comfort Highlights:</strong> <span class="text-slate-200">${p.comfort_highlights}</span></div>
          <div><strong class="text-amber-400">Verified Rating:</strong> ⭐ ${p.rating} / 5.0</div>
        </div>

        <div class="flex gap-2 pt-2">
          <button onclick="closeModal()" class="flex-1 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl transition">
            Close
          </button>
          <button onclick="alert('Proceeding with ' + p.name + ' based on your comfort criteria!')" class="flex-1 py-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs rounded-xl transition">
            Choose This Item
          </button>
        </div>
      `;
      modal.classList.remove("hidden");
    }

    function closeModal() {
      document.getElementById("productModal").classList.add("hidden");
    }

    // Initial render
    renderProducts();
  </script>

</body>
</html>
"""


class ShoppingAppServer(SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/" or self.path.startswith("/?"):
            self.send_response(200)
            self.send_header("Content-type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_TEMPLATE.encode("utf-8"))
        elif self.path == "/api/products":
            self.send_response(200)
            self.send_header("Content-type", "application/json; charset=utf-8")
            self.end_headers()
            self.wfile.write(json.dumps(PRODUCTS).encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()


def launch_server(port=PORT):
    server = HTTPServer(("127.0.0.1", port), ShoppingAppServer)
    url = f"http://127.0.0.1:{port}"
    print("=" * 75)
    print(f"🚀 SMART SHOP AI: Online Shopping & Comfort Recommendation App")
    print(f"🌐 Running locally at: {url}")
    print(f"💡 Opening your browser straight to the app now...")
    print("=" * 75)

    threading.Thread(target=lambda: (time.sleep(0.8), webbrowser.open(url))).start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping shopping server.")
        server.server_close()


if __name__ == "__main__":
    launch_server()
