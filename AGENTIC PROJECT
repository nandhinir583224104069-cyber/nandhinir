          const matchSpecs = p.specs.toLowerCase().includes(q);
          const matchComfort = p.comfort_highlights.toLowerCase().includes(q);
          const matchTags = p.tags && p.tags.some(t => t.toLowerCase().includes(q));
          if (!matchName && !matchCategory && !matchSpecs && !matchComfort && !matchTags) return false;
        }
        return true;
